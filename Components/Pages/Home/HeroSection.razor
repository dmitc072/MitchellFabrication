@inject DataService Data
@inject NavigationManager Nav


<div class="row even">
    <div class="column">
        <p id="veteran-tag" class="small-font letter-spacing"> * VETERAN-OWNED & SDVOSB CERTIFIED · CONYERS, GA </p>
        <h1 style="font-style:italic; font-weight:300" class="no-margin">Where ideas become</h1>
        <h1 style="font-weight:700; font-size:50px"class="no-margin">Built &</h1>
        <h1 class="red" style="font-weight:700; font-size:50px; ">Delivered</h1>
        <br>
        <p>From large-format printing to metal fabrication, laser engraving to event production — Mitchell Creative & Fabrication brings precision craftsmanship and military-grade accountability to every project.</p>
        <br>
        <div class="button">
            <button class="quote-button background-red">Request a Free Quote</button>
            <button class="quote-button background-red" @onclick='() => Nav.NavigateTo("/services")'>View our Services</button>
        </div>
        <br />
        <div class="row center">
            @for(int i=0;i<title.Length;i++){
            <div class="column border">
                <div class="text-center" style="font-size:25px">@title[i]</div>
                <div class="text-center" style="font-size:10px">@info[i]</div>
            </div>
            }
            
        </div>
        <br />
    </div>
    <div class="column">
        <div class="center" id= "service-box">
            <p class="service-title small-font">SERVICES AVAILABLE</p>
            <div class="row services-row">
                @foreach(var service in Data.Services){
                        <p class="service-selection small-font"
                            style='background-color: @(selectedService==service.Title ? "rgba(200, 55, 55, 1)" : "");
                                   color:@(selectedService==service.Title ? "white": "")'
                            @onclick= "() => SelectService(service.Title)"
                        >@service.Title</p>
                }
            </div>
            <p class="line"></p>
            <div class="service-start">
                <p style="font-size:12px; color:grey">Quotes with <span style="color:green">24 hours</span></p>
                <button 
                    id="start-button" 
                    class="@(selectedService == "" ? "button-disabled" : "background-red")"
                    @onclick="StartButton"
                    disabled="@(selectedService == "")"
                >Start &#10132;</button>
            </div>
        </div>
    </div>
</div>

@code
{
 string[] title = new []{"6+", "24hr", "ATL"};
 string[] info = new[]{"SERVICES", "QUOTE TURNAROUND", "METRO COVERAGE"};
 string selectedService = "";

 void SelectService(string s){
    selectedService = s;
 }

 void StartButton(){
    Console.WriteLine(selectedService);
 }
}