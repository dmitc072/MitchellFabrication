@page "/quote"
@rendermode InteractiveServer
@inject DataService Data

<div >
    <form class="quote-card">
    <div class="text-center">
        <h1 class="title">@Data.SelectedService</h1>
        <h2 class="subtitle">QUOTE</h2>
    </div>
    @Selection
    </form>
</div>

@code {

  RenderFragment Selection => Data.SelectedService switch
    {
        "Print & Signage"      => @<PrintQuote />,
        "Laser Engraving"      => @<LaserQuote />,
        "3D Printing"          => @<ThreeDQuote />,
        "Carpentry & Woodwork" => @<CarpentryQuote />,
        "Event Production"     => @<EventQuote />,
        _                      => @<PrintQuote />
    };


}