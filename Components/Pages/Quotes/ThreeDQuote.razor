<div>
    <div class="selection">
        <label style="font-weight:600">SELECT FILE</label>
        <InputFile OnChange="HandleFile" accept=".pdf,.png,.jpg" multiple/>
        @if(isMaxCapacity)
        {
            <p class="small-font red">Files exceed 20MB limit</p>
        }
    </div>

    @if (fileNames.Count > 0)
    {
        <p style="font-weight:600">Selected:</p>
        @foreach(var file in  uploadedFiles)
        {
            <div class="file-row file">
                <p>@Truncate(file.Name)</p>
                <button type="button" @onclick="()=>RemoveFile(file)">DELETE X</button>
            </div>
        }
        <p>@((20_000_000 - size) / 1024)KB remaining</p>
    }
    <button 
        @onclick="NeedDimension"
        type="button"
        class="center-button"
        >ADD DIMENISION</button>
    <div class="dimension-space">
    @if(needDimension)
    {
        @foreach(var key in Dimension.Keys)
        {
            <label class="dimension-row">@key.ToUpper()
                <input @bind="Dimension[key]" />
                @if(IsLarge(Dimension["width"], Dimension["height"]))
                {
                    <p class="small-font red">Max size is @maxWidth " X @maxHeight " </p>
                }
            </label>
        }
    }
    </div>
    <p>DESCRIPTION</p>
    <textarea maxlength="500" @bind="description" @bind:event="oninput"></textarea>
    <p class="small-font">@description.Length / 500</p>
</div>

@code {
    long size = 0;
    int maxWidth= 14;
    int maxHeight= 24;
    bool isMaxCapacity = false;
    string description = "";

    bool needDimension = false;

    string Truncate(string name) => name.Length > 30 ? name[..30] + "..." : name;

    async Task HandleFile(InputFileChangeEventArgs e)
    {
        var incoming = e.GetMultipleFiles();
        long incomingSize = incoming.Sum(f => f.Size);

        if (size + incomingSize < 20_000_000)
        {
            isMaxCapacity = false;
            foreach (var file in incoming)
            {
                size += file.Size;
                fileNames.Add(file.Name);
                uploadedFiles.Add(file);
            }
        }
        else
        {
            isMaxCapacity = true;
        }
    }

    void RemoveFile(IBrowserFile file)
    {
        size -= file.Size;
        uploadedFiles.Remove(file);
        fileNames.Remove(file.Name);
    }

    List<string> fileNames = new();
    List<IBrowserFile> uploadedFiles = new();

    Dictionary<string,string> Dimension = new()
        {
            ["width"] = "",
            ["height"] = ""
        };

    void NeedDimension (){
        needDimension = !needDimension;
    }

    bool IsLarge(string w, string h){
        double.TryParse(w, out double width);
        double.TryParse(h, out double height);
        double shorter = Math.Min(width,height);
        double longer = Math.Max(width,height);
        return longer > maxHeight || shorter > maxWidth;  
    }
   
}